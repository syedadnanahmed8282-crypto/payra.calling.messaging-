<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- user content (camera photos / videos, voice notes) -->
    <files-path name="captures" path="captures/" />
    <files-path name="voice" path="voice/" />
    <!-- saved downloads (phones older than Android 10) -->
    <external-files-path name="downloads" path="Download/" />
